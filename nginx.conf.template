server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    location /support {
        proxy_pass ${BACKEND_URL};
    }

    location /orders {
        proxy_pass ${BACKEND_URL};
    }

    location /hello {
        proxy_pass ${BACKEND_URL};
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
